load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_d//d:defs.bzl", "d_binary")

genrule(
    name = "addressbook_d_proto",
    srcs = ["addressbook.proto"],
    outs = ["tutorial/addressbook.d"],
    cmd = "set -- $(execpaths @protobuf//:well_known_type_protos); " +
          "WKT_ROOT=$${1%/google/protobuf/*}; " +
          "$(execpath @protobuf//:protoc) " +
          "--proto_path=examples " +
          "--proto_path=$$WKT_ROOT " +
          "--plugin=protoc-gen-d=$(execpath //protoc_gen_d:protoc-gen-d) " +
          "--d_out=$(RULEDIR) " +
          "$(execpath addressbook.proto)",
    cmd_bat = "for /f \"tokens=1\" %F in (\"$(execpaths @protobuf//:well_known_type_protos)\") do set WKT=%F&& " +
              "set WKT_ROOT=!WKT:\\google\\protobuf\\any.proto=!&& " +
              "$(execpath @protobuf//:protoc) " +
              "--proto_path=examples " +
              "--proto_path=!WKT_ROOT! " +
              "--plugin=protoc-gen-d=$(execpath //protoc_gen_d:protoc-gen-d) " +
              "--d_out=$(RULEDIR) " +
              "$(execpath addressbook.proto)",
    tools = [
        "//protoc_gen_d:protoc-gen-d",
        "@protobuf//:protoc",
        "@protobuf//:well_known_type_protos",
    ],
)

d_binary(
    name = "add_person",
    srcs = [
        "add_person.d",
        ":addressbook_d_proto",
    ],
    deps = ["//:protobuf"],
)

d_binary(
    name = "list_people",
    srcs = [
        "list_people.d",
        ":addressbook_d_proto",
    ],
    deps = ["//:protobuf"],
)

build_test(
    name = "examples_test",
    targets = [
        ":add_person",
        ":list_people",
    ],
)
